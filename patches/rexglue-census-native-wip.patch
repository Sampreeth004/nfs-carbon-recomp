+
+// Per call site (return address, CP thread or other) mprotect counters for the census.
+namespace {
+struct ProtectSite {
+  std::atomic<uintptr_t> key{0};  // return address | 1 if from the CP thread
+  std::atomic<uint64_t> calls{0};
+  std::atomic<uint64_t> ns{0};
+  std::atomic<uint64_t> bytes{0};
+};
+ProtectSite g_protect_sites[32];
+void RecordProtectSite(void* return_address, bool cp, uint64_t ns, size_t length) {
+  const uintptr_t key = (uintptr_t(return_address) & ~uintptr_t(1)) | (cp ? 1 : 0);
+  for (size_t i = 0; i < 32; ++i) {
+    ProtectSite& s = g_protect_sites[(key / 4 + i) & 31];
+    uintptr_t expected = 0;
+    if (s.key.load(std::memory_order_relaxed) == key ||
+        s.key.compare_exchange_strong(expected, key, std::memory_order_relaxed) || expected == key) {
+      s.calls.fetch_add(1, std::memory_order_relaxed);
+      s.ns.fetch_add(ns, std::memory_order_relaxed);
+      s.bytes.fetch_add(length, std::memory_order_relaxed);
+      return;
+    }
+  }
+}
+}  // namespace
+
+// Writes up to 'max' lines "key calls ns bytes" for the census and clears the table.
+extern "C" __attribute__((visibility("default"))) size_t nfscarbon_protect_sites_dump(
+    uintptr_t* out_key, uint64_t* out_calls, uint64_t* out_ns, uint64_t* out_bytes, size_t max) {
+  size_t n = 0;
+  for (ProtectSite& s : g_protect_sites) {
+    const uintptr_t key = s.key.load(std::memory_order_relaxed);
+    if (!key) {
+      continue;
+    }
+    if (n < max) {
+      out_key[n] = key;
+      out_calls[n] = s.calls.exchange(0, std::memory_order_relaxed);
+      out_ns[n] = s.ns.exchange(0, std::memory_order_relaxed);
+      out_bytes[n] = s.bytes.exchange(0, std::memory_order_relaxed);
+      ++n;
+    }
+  }
+  return n;
+}
